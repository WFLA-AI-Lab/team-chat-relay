{$CHAT_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	# 门户跳转页：/portal，三张卡片串联聊天站/擂台/教程站。
	handle /portal* {
		reverse_proxy portal:8083
	}

	# Agent 擂台：与聊天站同域名，挂在 /arena 子路径下（登录 cookie 通用）。
	# /arena* 同时匹配无斜杠的 /arena 与 /arena/xxx（handle /arena/* 会漏掉裸 /arena）。
	handle /arena* {
		reverse_proxy arena:8081
	}

	handle {
		reverse_proxy open-webui:8080 {
			# Deliver SSE chunks immediately for low perceived latency.
			flush_interval -1
		}
	}
}

# 教程站：tutorial 子域名（如 tutorial.wfla-ailab.top，需 DNS 指向服务器）。
{$TUTORIAL_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy tutorial:8082
}
