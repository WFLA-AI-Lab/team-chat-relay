# Public address. Point this domain's A/AAAA record to the server first.
CHAT_DOMAIN=chat.example.org
# Agent arena subdomain (add a DNS A record: arena -> server IP).
ARENA_DOMAIN=arena.example.org
# Tutorial site subdomain (add a DNS A record: tutorial -> server IP).
TUTORIAL_DOMAIN=tutorial.example.org
TZ=Asia/Shanghai

# Pinned upstream images. Review release notes before changing these values.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
POSTGRES_IMAGE=postgres:17.10-alpine
CADDY_IMAGE=caddy:2.10.2-alpine

# DeepSeek official API (https://platform.deepseek.com -> API Keys).
# Create a key there and paste it into DEEPSEEK_API_KEY. It is the only
# upstream used by every agent, so there is no shared-account ban risk.
DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY__
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Bootstrap replaces the placeholders below. Never commit the generated .env.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
WEBUI_SECRET_KEY=__WEBUI_SECRET_KEY__
ARENA_SECRET=__ARENA_SECRET__

# Initial administrator. Change the email/name before the first deployment.
WEBUI_ADMIN_EMAIL=admin@example.org
WEBUI_ADMIN_NAME=Administrator
WEBUI_ADMIN_PASSWORD=__WEBUI_ADMIN_PASSWORD__
