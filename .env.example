# Public address. Point this domain's A/AAAA record to the server first.
CHAT_DOMAIN=chat.example.org
# Agent arena subdomain (add a DNS A record: arena -> server IP).
ARENA_DOMAIN=arena.example.org
# Tutorial site subdomain (add a DNS A record: tutorial -> server IP).
TUTORIAL_DOMAIN=tutorial.example.org
TZ=Asia/Shanghai

# Pinned upstream images. Review release notes before changing these values.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0
POSTGRES_IMAGE=postgres:17.10-alpine
CADDY_IMAGE=caddy:2.10.2-alpine

# DeepSeek official API (https://platform.deepseek.com -> API Keys).
# Create a key there and paste it into DEEPSEEK_API_KEY. It is the only
# upstream used by every agent, so there is no shared-account ban risk.
DEEPSEEK_API_KEY=__DEEPSEEK_API_KEY__
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选备用供应商（arena 擂台按模型前缀自动路由给本代码）。
# 只在对应平台设有余额时填写 Key，留空则禁用该供应商。
# OpenRouter：https://openrouter.ai —— 模型名形如 openrouter:deepseek/deepseek-chat-v3-0324
OPENROUTER_API_KEY=__OPENROUTER_API_KEY__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 基元律动（Token Rhythm）：https://tokenrhythm.studio —— “中国版 OpenRouter”，
# 一个 Key 聚合 GLM/Kimi/DeepSeek/Qwen 等，模型名形如 jiyuan:glm-5.2
JIYUAN_API_KEY=__JIYUAN_API_KEY__
JIYUAN_BASE_URL=https://tokenrhythm.studio/v1

# Bootstrap replaces the placeholders below. Never commit the generated .env.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
WEBUI_SECRET_KEY=__WEBUI_SECRET_KEY__
ARENA_SECRET=__ARENA_SECRET__

# Initial administrator. Change the email/name before the first deployment.
WEBUI_ADMIN_EMAIL=kangkang100402qw@hotmail.com
WEBUI_ADMIN_NAME=ricykang402
WEBUI_ADMIN_PASSWORD=__WEBUI_ADMIN_PASSWORD__

# ---- 学校账号统一登录 + 白名单 ----------------------------------------
# SCHOOL_AUTH_ENABLED=1 时，登录页出现「用学校账号登录」：
# 学生用 WFLA 高中综合系统的学号+密码登录，平台只拿它去学校系统验证一次，
# 不保存密码；验证通过后还要在白名单里（社长后台手动加）才能进入。
# 改完记得 docker compose up -d arena，并确认容器能访问 101.227.232.33:8001。
SCHOOL_AUTH_ENABLED=0
SCHOOL_LOGIN_URL=http://101.227.232.33:8001/Home/Login
# 学号映射成聊天站内部邮箱用的域名（学生看不到，随便一个你自己的子域名即可）
SCHOOL_EMAIL_DOMAIN=stu.wfla-ailab.top
# 留空 = 自动：请求来自 *.wfla-ailab.top 时把登录 cookie 种到 .wfla-ailab.top
SCHOOL_COOKIE_DOMAIN=

# ---- 教程站站内登录 ---------------------------------------------------
# 教程站（tutorial.xxx）可以就地登录：用聊天站账号验一次密码，成功后把 token
# 种到下面的域名上，于是聊天站 / 擂台 / 教程站共用同一个登录态（30 天）。
# 留空 = 按请求域名自动判断（*.wfla-ailab.top）。
COOKIE_DOMAIN=
